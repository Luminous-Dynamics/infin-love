# Auto detect text files and perform LF normalization
* text=auto

# HTML
*.html text eol=lf
*.htm text eol=lf

# CSS
*.css text eol=lf

# JavaScript
*.js text eol=lf
*.json text eol=lf

# Markdown
*.md text eol=lf
*.markdown text eol=lf

# XML
*.xml text eol=lf
*.svg text eol=lf

# Config files
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf

# Images
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.webp binary

# Archives
*.zip binary
*.tar binary
*.gz binary

# Fonts
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
